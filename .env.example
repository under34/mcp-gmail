# Copy to .env and add only the key for the provider you select. Values for
# AI_PROVIDER are openai or claude (case and surrounding whitespace are ignored).
# A blank or whitespace-only key is treated as not configured.
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: used by the OAuth story; keep the real file outside this repository.
GMAIL_CREDENTIALS_PATH=

# Optional test/development override. Leave empty in normal local use.
GMAIL_MCP_DATA_DIR=
